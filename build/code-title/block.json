{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "wporg/code-reference-title",
  "version": "0.1.0",
  "title": "Code Reference: Title",
  "category": "widgets",
  "icon": "smiley",
  "description": "Show the code signature for a function, class, or method.",
  "usesContext": [
    "postId"
  ],
  "attributes": {
    "isLink": {
      "type": "boolean",
      "default": false
    },
    "tagName": {
      "type": "string",
      "enum": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "p",
        "dt",
        "div",
        "span"
      ],
      "default": "h1"
    }
  },
  "supports": {
    "html": false,
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "textdomain": "wporg",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}