{
	"name": "wordpress/wporg-developer",
	"description": "",
	"homepage": "https://developer.wordpress.org/",
	"license": "GPL-2.0-or-later",
	"support": {
		"issues": "https://github.com/WordPress/wporg-developer/issues"
	},
	"minimum-stability": "dev",
	"config": {
		"platform": {
			"php": "8.4"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		},
		"preferred-install": {
			"wordpress/*": "source",
			"wporg/*": "source"
		},
		"audit": {
			"ignore": ["PKSA-z3gr-8qht-p93v"]
		}
	},
	"extra": {
		"installer-paths": {
			"source/wp-content/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
			"source/wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
			"source/wp-content/themes/{$name}/": ["type:wordpress-theme"]
		}
	},
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "wordpress-plugin/gutenberg",
				"type": "wordpress-plugin",
				"version": "1",
				"dist": {
					"type": "zip",
					"url": "https://downloads.wordpress.org/plugin/gutenberg.zip"
				}
			}
		},
		{
			"type": "package",
			"package": {
				"name": "wordpress-plugin/wordpress-importer",
				"type": "wordpress-plugin",
				"version": "1",
				"dist": {
					"type": "zip",
					"url": "https://downloads.wordpress.org/plugin/wordpress-importer.zip"
				}
			}
		},
		{
			"type": "package",
			"package": {
				"name": "wordpress-plugin/code-syntax-block",
				"type": "wordpress-plugin",
				"version": "1",
				"dist": {
					"type": "zip",
					"url": "https://downloads.wordpress.org/plugin/code-syntax-block.zip"
				}
			}
		},
		{
			"type": "package",
			"package": {
				"name": "wordpress-plugin/posts-to-posts",
				"type": "wordpress-plugin",
				"version": "1",
				"dist": {
					"type": "zip",
					"url": "https://downloads.wordpress.org/plugin/posts-to-posts.zip"
				}
			}
		},
		{
			"type": "package",
			"package": {
				"name": "wordpress-plugin/jetpack",
				"type": "wordpress-plugin",
				"version": "1",
				"dist": {
					"type": "zip",
					"url": "https://downloads.wordpress.org/plugin/jetpack.zip"
				}
			}
		},
		{
			"type": "vcs",
			"url": "git@github.com:WordPress/wporg-repo-tools.git"
		},
		{
			"type": "vcs",
			"url": "git@github.com:WordPress/wporg-mu-plugins.git"
		},
		{
			"type": "package",
			"package": {
				"name": "wordpress/phpdoc-parser",
				"type": "wordpress-plugin",
				"version": "dev-master",
				"source": {
					"type": "git",
					"url": "git@github.com:WordPress/phpdoc-parser.git",
					"reference": "master"
				}
			}
		},
		{
			"type": "vcs",
			"url": "git@github.com:WordPress/wporg-parent-2021.git"
		},
		{
			"type": "package",
			"package": [
				{
					"name": "wordpress-meta/pub",
					"type": "wordpress-muplugin",
					"version": "1",
					"source": {
						"type": "svn",
						"url": "https://meta.svn.wordpress.org/sites/",
						"reference": "trunk/wordpress.org/public_html/wp-content/mu-plugins/pub/"
					}
				},
				{
					"name": "wordpress-meta/wporg-markdown",
					"type": "wordpress-plugin",
					"version": "1",
					"source": {
						"type": "svn",
						"url": "https://meta.svn.wordpress.org/sites/",
						"reference": "trunk/wordpress.org/public_html/wp-content/plugins/wporg-markdown/"
					}
				},
				{
					"name": "wordpress-meta/handbook",
					"type": "wordpress-plugin",
					"version": "2",
					"source": {
						"type": "svn",
						"url": "https://meta.svn.wordpress.org/sites/",
						"reference": "trunk/wordpress.org/public_html/wp-content/plugins/handbook/"
					}
				}
			]
		}
	],
	"require-dev": {
		"composer/installers": "^2.0",
		"wordpress-plugin/gutenberg": "*",
		"wordpress-plugin/wordpress-importer": "*",
		"wordpress-plugin/code-syntax-block": "*",
		"wordpress-plugin/posts-to-posts": "*",
		"wordpress-plugin/jetpack": "*",
		"wordpress-meta/pub": "1",
		"wordpress-meta/wporg-markdown": "1",
		"wordpress-meta/handbook": "2",
		"wporg/wporg-repo-tools": "dev-trunk",
		"wporg/wporg-mu-plugins": "dev-build",
		"wordpress/phpdoc-parser": "dev-master",
		"wporg/wporg-parent-2021": "dev-build",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"squizlabs/php_codesniffer": "^3.13.6",
		"wp-coding-standards/wpcs": "^3.4.1",
		"phpcompatibility/phpcompatibility-wp": "^2.0",
		"wp-phpunit/wp-phpunit": "^6.0",
		"phpunit/phpunit": "^10.5",
		"yoast/phpunit-polyfills": "^2.0",
		"dd32/wpcli-cron-concurrent": "dev-trunk"
	},
	"scripts": {
		"format": "phpcbf -p",
		"lint": "phpcs"
	}
}
